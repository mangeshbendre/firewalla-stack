{
  "uid": "fw-web-timeline",
  "title": "Website Visit Timeline",
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "tags": ["firewalla", "timeline", "dns"],
  "templating": {
    "list": [
      {
        "name": "device_mac",
        "label": "Device MAC (regex)",
        "type": "textbox",
        "query": ".*",
        "current": { "value": ".*", "text": ".*" },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "DNS Query Rate (queries/sec)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 16, "h": 6 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "showPoints": "auto",
            "spanNulls": true
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate({job=\"firewalla\", type=\"dns_allowed\"} |~ \"$device_mac\" [5m]))",
          "legendFormat": "Allowed queries/sec",
          "refId": "A"
        },
        {
          "expr": "sum(rate({job=\"firewalla\", type=\"dns_blocked\"} |~ \"$device_mac\" [5m]))",
          "legendFormat": "Blocked queries/sec",
          "refId": "B"
        }
      ]
    },
    {
      "id": 2,
      "title": "Top Visited Domains (last 1h)",
      "type": "barchart",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 6 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "orientation": "horizontal",
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" },
        "barWidth": 0.7,
        "fillOpacity": 80
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "hideFrom": { "legend": false, "tooltip": false, "viz": false } }
        }
      },
      "targets": [
        {
          "expr": "topk(15, sum by(domain) (count_over_time({job=\"firewalla\", type=\"dns_allowed\"} |~ \"$device_mac\" | regexp \"dn=(?P<domain>[^ ]+)\" [1h])))",
          "legendFormat": "{{domain}}",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Live DNS Query Stream",
      "type": "logs",
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 12 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false
      },
      "targets": [
        {
          "expr": "{job=\"firewalla\", type=\"dns_allowed\"} |~ \"$device_mac\"",
          "legendFormat": "",
          "refId": "A",
          "maxLines": 500
        }
      ]
    },
    {
      "id": 4,
      "title": "Recent Visits — Extracted mac + domain",
      "type": "table",
      "gridPos": { "x": 0, "y": 18, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "footer": { "show": false },
        "sortBy": [{ "displayName": "Time", "desc": true }]
      },
      "fieldConfig": {
        "defaults": { "custom": { "filterable": true } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Time" },
            "properties": [{ "id": "unit", "value": "dateTimeAsIso" }]
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "tsNs": "Time",
              "mac": "Device MAC",
              "domain": "Domain",
              "Line": "Raw"
            },
            "excludeByName": { "id": true, "type": true, "job": true, "host": true, "app": true }
          }
        }
      ],
      "targets": [
        {
          "expr": "{job=\"firewalla\", type=\"dns_allowed\"} |~ \"$device_mac\" | regexp \"mac=(?P<mac>[0-9a-fA-F:]{17}).*dn=(?P<domain>[^ ]+)\"",
          "legendFormat": "",
          "refId": "A",
          "maxLines": 1000
        }
      ]
    },
    {
      "id": 5,
      "title": "Query Volume per Device (last 6h)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 28, "w": 24, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "legend": { "displayMode": "list", "placement": "right" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "showPoints": "auto",
            "spanNulls": true
          }
        }
      },
      "targets": [
        {
          "expr": "sum by(mac) (count_over_time({job=\"firewalla\", type=\"dns_allowed\"} | regexp \"mac=(?P<mac>[0-9a-fA-F:]{17})\" [5m]))",
          "legendFormat": "{{mac}}",
          "refId": "A"
        }
      ]
    }
  ]
}
