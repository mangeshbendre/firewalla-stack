{
  "uid": "fw-web-time",
  "title": "Time on Websites",
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "tags": ["firewalla", "websites"],
  "templating": {
    "list": [
      {
        "name": "device",
        "label": "Device",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(firewalla_domain_duration_seconds, name)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "sort": 1,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Total Time Online",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3600 },
              { "color": "red", "value": 14400 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(firewalla_domain_duration_seconds{name=~\"$device\"})",
          "legendFormat": "Total",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Unique Domains Contacted",
      "type": "stat",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        }
      },
      "targets": [
        {
          "expr": "count(firewalla_domain_duration_seconds{name=~\"$device\"})",
          "legendFormat": "Domains",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Total Data Transferred",
      "type": "stat",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "purple", "value": null }]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(firewalla_top_domain_bytes{name=~\"$device\"})",
          "legendFormat": "Total Bytes",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Top 20 Domains by Time Spent",
      "type": "barchart",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "orientation": "horizontal",
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" },
        "xTickLabelRotation": 0,
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "fillOpacity": 80,
        "gradientMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": { "hideFrom": { "legend": false, "tooltip": false, "viz": false } }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "topk(20, firewalla_domain_duration_seconds{name=~\"$device\"})",
          "legendFormat": "{{domain}}",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Top 20 Domains by Bytes",
      "type": "barchart",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "orientation": "horizontal",
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" },
        "barWidth": 0.7,
        "fillOpacity": 80,
        "gradientMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "palette-classic" },
          "custom": { "hideFrom": { "legend": false, "tooltip": false, "viz": false } }
        }
      },
      "targets": [
        {
          "expr": "topk(20, sum by(domain) (firewalla_top_domain_bytes{name=~\"$device\"}))",
          "legendFormat": "{{domain}}",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Cumulative Time Online (Rolling 24h)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 18, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "auto",
            "spanNulls": true
          }
        }
      },
      "targets": [
        {
          "expr": "sum(firewalla_domain_duration_seconds{name=~\"$device\"})",
          "legendFormat": "Total Time",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "All Domains — Duration & Bytes",
      "type": "table",
      "gridPos": { "x": 0, "y": 26, "w": 24, "h": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "sortBy": [{ "displayName": "Duration", "desc": true }],
        "footer": { "show": false }
      },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Duration" },
            "properties": [
              { "id": "unit", "value": "s" },
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 600 },
                    { "color": "red", "value": 3600 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Bytes" },
            "properties": [{ "id": "unit", "value": "bytes" }]
          }
        ]
      },
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "domain": "Domain",
              "Value #A": "Duration",
              "Value #B": "Bytes"
            },
            "excludeByName": { "Time": true, "mac": true, "name": true, "__name__": true }
          }
        }
      ],
      "targets": [
        {
          "expr": "firewalla_domain_duration_seconds{name=~\"$device\"}",
          "legendFormat": "{{domain}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "sum by(domain) (firewalla_top_domain_bytes{name=~\"$device\"})",
          "legendFormat": "{{domain}}",
          "refId": "B",
          "instant": true,
          "format": "table"
        }
      ]
    }
  ]
}
